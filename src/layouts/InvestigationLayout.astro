---
import type { Investigation } from '../utils/investigations';
import BaseLayout from './BaseLayout.astro';
import ClaimStatus from '../components/ClaimStatus.astro';
import ActionList from '../components/ActionList.astro';
import InvestigationCard from '../components/InvestigationCard.astro';
import SourceList from '../components/SourceList.astro';
import { formatDate } from '../utils/investigations';
import { slugify, withBase } from '../utils/paths';

interface Props { investigation: Investigation; related?: Investigation[]; }
const { investigation, related = [] } = Astro.props;
const { data } = investigation;
---

<BaseLayout title={data.seo?.title ?? data.title} description={data.seo?.description ?? data.description} image={data.seo?.image ?? data.heroImage} type="article" publishedDate={data.publishedDate} updatedDate={data.updatedDate} authors={data.authors}>
  <article>
    <header class="article-header shell">
      <div class="file-reference"><span>Investigation file</span><strong>{data.slug.replaceAll('-', ' / ')}</strong><span>Public record</span></div>
      <p class="eyebrow"><span>{data.demonstration ? 'Demonstration' : 'Investigation'}</span> · Evidence review</p>
      <h1>{data.title}</h1>
      <p class="dek">{data.description}</p>
      <dl class="article-meta">
        <div><dt>Published</dt><dd><time datetime={data.publishedDate.toISOString()}>{formatDate(data.publishedDate)}</time></dd></div>
        {data.updatedDate && <div><dt>Updated</dt><dd><time datetime={data.updatedDate.toISOString()}>{formatDate(data.updatedDate)}</time></dd></div>}
        <div><dt>Filed by</dt><dd>{data.authors.join(', ')}</dd></div>
        <div><dt>Jurisdiction</dt><dd><a href={withBase(`/jurisdictions/${slugify(data.jurisdiction)}/`)}>{data.jurisdiction}</a></dd></div>
      </dl>
      <ul class="topics" aria-label="Topics">{data.topics.map((topic) => <li><a href={withBase(`/topics/${slugify(topic)}/`)}>{topic}</a></li>)}</ul>
    </header>

    <div class="article-grid shell">
      <aside class="summary" aria-labelledby="summary-title">
        <div class="summary-label"><span>The short version</span><span>30-second read</span></div>
        <h2 id="summary-title">Findings, fast</h2>
        <ul>{data.summary.map((item) => <li>{item}</li>)}</ul>
        <div class="status-key"><span>Evidence language key</span><ClaimStatus status="confirmed" /><ClaimStatus status="supported" /><ClaimStatus status="alleged" /><ClaimStatus status="unresolved" /></div>
      </aside>
      <div class="prose">{data.actions.length > 0 && <ActionList actions={data.actions} />}<slot /><SourceList sources={data.sources} /></div>
    </div>
    {related.length > 0 && <section class="related shell" aria-labelledby="related-title"><div class="section-heading"><h2 id="related-title">Related investigations</h2></div><div class="listing-grid">{related.map((item) => <InvestigationCard investigation={item} />)}</div></section>}
  </article>
</BaseLayout>

<style>
  .article-header { padding-block: 2.4rem 2.8rem; border-bottom: 0.35rem solid var(--ink); }
  .file-reference { display: grid; grid-template-columns: auto 1fr auto; gap: 1rem; margin-bottom: 4rem; padding-block: 0.42rem; border-block: 1px solid var(--rule); color: var(--muted); font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .file-reference strong { color: var(--ink); text-align: center; }
  .eyebrow span { padding: 0.12rem 0.28rem; background: var(--accent); color: var(--ink); }
  h1 { max-width: 20ch; margin: 0; font-family: var(--serif); font-size: clamp(2.6rem, 6.4vw, 6rem); font-weight: 700; letter-spacing: -0.055em; line-height: 0.94; overflow-wrap: anywhere; }
  .dek { max-width: 50rem; margin: 1.5rem 0 2.2rem; color: var(--muted); font-family: var(--serif); font-size: clamp(1.2rem, 2.5vw, 1.55rem); line-height: 1.45; overflow-wrap: anywhere; }
  .article-meta { display: grid; grid-template-columns: repeat(4, minmax(8rem, 1fr)); gap: 0; margin: 0; border: 1px solid var(--rule); border-right: 0; }
  .article-meta div { padding: 0.6rem 0.75rem; border-right: 1px solid var(--rule); }
  .article-meta dt { color: var(--muted); font-family: var(--mono); font-size: 0.67rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; }
  .article-meta dd { margin: 0.15rem 0 0; font-size: 0.86rem; font-weight: 700; line-height: 1.35; }
  .topics { display: flex; gap: 0.6rem; margin: 1.2rem 0 0; padding: 0; flex-wrap: wrap; list-style: none; }
  .topics a { padding: 0.2rem 0.42rem; border: 1px solid var(--ink); background: var(--surface); font-family: var(--mono); font-size: 0.68rem; font-weight: 700; text-decoration: none; text-transform: uppercase; }
  .topics a:hover { background: var(--accent); }
  .article-grid { display: grid; min-width: 0; grid-template-columns: minmax(15rem, 0.36fr) minmax(0, 1fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; padding-block: 3.5rem 6rem; }
  .article-grid > * { min-width: 0; }
  .summary { position: sticky; top: 1rem; min-width: 0; padding: 0 1rem 1.2rem; border: 1px solid var(--ink); background: var(--surface); }
  .summary::before { display: block; width: 5rem; height: 0.75rem; margin: -0.42rem 1rem 1rem auto; content: ""; background: var(--accent); opacity: 0.8; }
  .summary-label { display: flex; justify-content: space-between; padding-bottom: 0.45rem; border-bottom: 1px solid var(--rule); color: var(--muted); font-family: var(--mono); font-size: 0.66rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .summary h2 { margin: 1rem 0 0; font-family: var(--serif); font-size: 1.55rem; letter-spacing: -0.035em; }
  .summary ul { margin: 1rem 0 0; padding: 0; list-style: none; counter-reset: finding; }
  .summary li { display: grid; grid-template-columns: 1.5rem minmax(0, 1fr); gap: 0.35rem; margin-bottom: 0.8rem; font-family: var(--serif); line-height: 1.45; overflow-wrap: anywhere; counter-increment: finding; }
  .summary li::before { content: counter(finding, decimal-leading-zero); font-family: var(--mono); font-size: 0.68rem; font-weight: 700; }
  .status-key { display: flex; gap: 0.45rem; margin-top: 1.5rem; flex-wrap: wrap; }
  .status-key > span { width: 100%; color: var(--muted); font-family: var(--mono); font-size: 0.67rem; font-weight: 700; text-transform: uppercase; }
  .related { padding-bottom: 6rem; }
  @media (max-width: 58rem) { .article-meta { grid-template-columns: 1fr 1fr; } .article-meta div { border-bottom: 1px solid var(--rule); } }
  @media (max-width: 49rem) { .file-reference { grid-template-columns: minmax(0, 1fr) auto; margin-bottom: 2.5rem; } .file-reference strong { display: none; } .article-grid { grid-template-columns: minmax(0, 1fr); } .summary { position: static; } }
  @media (max-width: 35rem) { .article-meta { grid-template-columns: 1fr; } }
</style>
