---
interface Props { title: string; organization: string; documentType: string; url: string; date?: string; }
const { title, organization, documentType, url, date } = Astro.props;
---

<a class="document-link" href={url} rel="external">
  <span class="document-type">Document / {documentType}</span><strong>{title}</strong><span>{organization}{date ? ` · ${date}` : ''}</span><span class="open">View source ↗</span>
</a>

<style>
  .document-link { display: grid; grid-template-columns: minmax(8rem, 0.32fr) minmax(0, 1fr) auto; gap: 0.25rem 1rem; margin: 1.7rem 0; padding: 1rem; border: 1px solid var(--rule); border-left: 0.35rem solid var(--ink); background: var(--surface); font-family: var(--sans); text-decoration: none; }
  .document-link:hover { background: var(--color-accent-soft); }
  .document-type { grid-row: 1 / 3; color: var(--muted); font-family: var(--mono); font-size: 0.7rem; font-weight: 700; text-transform: uppercase; }
  strong { line-height: 1.25; }
  strong + span { color: var(--muted); font-size: 0.86rem; }
  .open { grid-column: 3; grid-row: 1 / 3; align-self: center; padding-bottom: 0.1rem; border-bottom: 0.45rem solid var(--accent); font-family: var(--mono); font-size: 0.7rem; font-weight: 700; text-transform: uppercase; }
  @media (max-width: 34rem) { .document-link { grid-template-columns: 1fr; } .document-type, .open { grid-column: auto; grid-row: auto; } }
</style>
