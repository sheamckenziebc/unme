---
interface Props { title: string; organization: string; documentType: string; url: string; date?: string; }
const { title, organization, documentType, url, date } = Astro.props;
---

<a class="document-link" href={url} rel="external">
  <span class="document-type">{documentType}</span><strong>{title}</strong><span>{organization}{date ? ` · ${date}` : ''}</span><span class="open">Open original ↗</span>
</a>

<style>
  .document-link { display: grid; grid-template-columns: minmax(7rem, 0.3fr) minmax(0, 1fr) auto; gap: 0.25rem 1rem; margin: 1.5rem 0; padding: 1rem 0; border-block: 1px solid var(--rule); font-family: var(--sans); text-decoration: none; }
  .document-type { grid-row: 1 / 3; color: var(--accent-dark); font-family: var(--mono); font-size: 0.72rem; font-weight: 700; text-transform: uppercase; }
  strong { line-height: 1.25; }
  strong + span { color: var(--muted); font-size: 0.86rem; }
  .open { grid-column: 3; grid-row: 1 / 3; align-self: center; font-family: var(--mono); font-size: 0.72rem; font-weight: 700; text-transform: uppercase; }
  @media (max-width: 34rem) { .document-link { grid-template-columns: 1fr; } .document-type, .open { grid-column: auto; grid-row: auto; } }
</style>
