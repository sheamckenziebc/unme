---
interface Props { date: string; }
const { date } = Astro.props;
---

<aside class="note"><strong>Correction record / {date}</strong><div><slot /></div></aside>
<style>.note { margin: 2.2rem 0; padding: 1rem 1.1rem; border: 1px solid var(--color-danger); border-left-width: 0.4rem; background: var(--surface); font-family: var(--sans); }.note strong { color: var(--color-danger); font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; }.note div :global(p) { margin: 0.35rem 0 0; color: var(--muted); }</style>
