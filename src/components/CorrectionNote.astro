---
interface Props { date: string; }
const { date } = Astro.props;
---

<aside class="note"><strong>Correction · {date}</strong><div><slot /></div></aside>
<style>.note { margin: 2rem 0; padding: 1rem; border-left: 0.3rem solid var(--accent); background: #f3e6e6; font-family: var(--sans); }.note strong { font-family: var(--mono); font-size: 0.75rem; text-transform: uppercase; }.note div :global(p) { margin: 0.35rem 0 0; }</style>
