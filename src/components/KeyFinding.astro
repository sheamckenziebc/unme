---
interface Props { number?: number; title: string; }
const { number, title } = Astro.props;
---

<aside class="key-finding"><p>{number ? `Finding ${String(number).padStart(2, '0')}` : 'Key finding'}</p><h3>{title}</h3><div><slot /></div></aside>

<style>
  .key-finding { position: relative; margin: 2.8rem 0; padding: 1.4rem 1.5rem 1.5rem; border-block: 0.22rem solid var(--ink); background: var(--color-accent-soft); color: var(--ink); font-family: var(--sans); }
  .key-finding::before { position: absolute; top: 0; bottom: 0; left: 0.45rem; width: 1px; content: ""; background: var(--ink); }
  p { margin: 0; font-family: var(--mono); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  h3 { margin: 0.65rem 0 !important; max-width: 24ch; font-family: var(--serif) !important; font-size: clamp(1.5rem, 3vw, 2.1rem) !important; letter-spacing: -0.025em; line-height: 1.08; }
  div :global(p) { margin: 0; max-width: 52ch; color: var(--muted); }
</style>
