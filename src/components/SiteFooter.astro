---
import { siteConfig } from '../config/site';
import { withBase } from '../utils/paths';
---

<footer>
  <div class="closing-rule" aria-hidden="true"></div>
  <div class="shell footer-grid">
    <div class="footer-brand"><strong>UR NOT <mark>MAD ENOUGH</mark></strong><p>{siteConfig.tagline}</p></div>
    <nav aria-label="Footer navigation">
      <a href={withBase('/about/')}>About</a>
      <a href={withBase('/corrections/')}>Corrections</a>
      <a href={withBase('/methodology/')}>Methodology</a>
      <a href={withBase('/rss.xml')}>RSS</a>
    </nav>
  </div>
</footer>

<style>
  footer { padding: 0 0 2.5rem; background: var(--ink); color: var(--surface); }
  .closing-rule { height: 0.6rem; margin-bottom: 2.5rem; background: var(--accent); }
  .footer-grid { display: grid; grid-template-columns: 1fr auto; gap: 2rem; }
  strong { font-size: 1.25rem; letter-spacing: -0.045em; }
  mark { padding-inline: 0.16rem; background: var(--accent); color: var(--ink); }
  p { margin: 0.25rem 0 0; color: #c9c9c9; }
  nav { display: flex; gap: 1rem; align-items: flex-start; font-family: var(--mono); font-size: 0.75rem; text-transform: uppercase; }
  @media (max-width: 36rem) { .footer-grid { grid-template-columns: 1fr; } }
</style>
