---
import { siteConfig } from '../config/site';
import { withBase } from '../utils/paths';

const navigation = [
  { href: '/atlas/', label: 'Directory' },
  { href: '/investigations/', label: 'Reporting' },
  { href: '/about/', label: 'About' },
];
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => {
  const resolved = withBase(href);
  return currentPath === resolved || (href !== '/' && currentPath.startsWith(resolved));
};
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href={withBase('/')} aria-label={`${siteConfig.name}, home`}>
      <span>UR NOT</span> <mark>MAD ENOUGH</mark>
    </a>
    <nav aria-label="Primary navigation">
      <ul>
        {navigation.map((item) => <li><a href={withBase(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header { background: #101813; color: #f3f1e7; border-bottom: 1px solid #43503d; }
  .header-inner { display: flex; gap: 2rem; align-items: center; justify-content: space-between; padding-block: 0.85rem; }
  .wordmark { display: inline-flex; gap: 0.28em; width: fit-content; align-items: baseline; font-size: 1.2rem; font-weight: 900; letter-spacing: -0.055em; line-height: 1; text-decoration: none; min-height: 44px; }
  .wordmark > span { white-space: nowrap; }
  .wordmark mark { padding: 0.04em 0.12em 0.02em; background: var(--accent); color: var(--ink); white-space: nowrap; }
  nav ul { display: flex; gap: 0.2rem 1.3rem; justify-content: flex-end; margin: 0; padding: 0; flex-wrap: wrap; list-style: none; }
  nav a { display: inline-flex; min-height: 44px; align-items: center; font-family: var(--sans); font-size: 0.85rem; text-decoration: none; }
  nav a:hover { color: #eddda5; }
  a:focus-visible { outline-color: #f1d537; }
  nav a[aria-current="page"] { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 0.35rem; text-underline-offset: 0.16rem; }
  @media (max-width: 48rem) { .header-inner { flex-wrap: wrap; gap: 0.1rem 1rem; } nav ul { justify-content: flex-start; } }
  @media (max-width: 35rem) {
    .header-inner { gap: 0.75rem; padding-block: 0.85rem; }
    .wordmark { font-size: 1.1rem; }
    nav ul { gap: 0 0.74rem; }
    nav a { min-height: 44px; padding: 0.2rem 0.4rem; font-size: 0.84rem; }
  }
</style>
