---
import { siteConfig } from '../config/site';
import { withBase } from '../utils/paths';

const navigation = [
  { href: '/dossiers/', label: 'Dossiers' },
  { href: '/briefs/', label: 'Briefs' },
  { href: '/ledger/', label: 'Ledger' },
  { href: '/investigations/', label: 'Archive' },
  { href: '/methodology/', label: 'Methodology' },
];
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => {
  const resolved = withBase(href);
  return currentPath === resolved || (href !== '/' && currentPath.startsWith(resolved));
};
---

<header class="site-header">
  <div class="filing-strip">
    <div class="shell"><span>Independent accountability publication</span><span>Public record · Evidence first</span></div>
  </div>
  <div class="shell header-inner">
    <a class="wordmark" href={withBase('/')} aria-label={`${siteConfig.name}, home`}>
      <span>UR NOT</span> <mark>MAD ENOUGH</mark>
    </a>
    <nav aria-label="Primary navigation">
      <ul>
        {navigation.map((item) => <li><a href={withBase(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header { background: var(--surface); border-bottom: 0.22rem solid var(--ink); }
  .filing-strip { padding: 0.32rem 0; background: var(--ink); color: var(--surface); font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .filing-strip .shell { display: flex; justify-content: space-between; }
  .header-inner { display: grid; grid-template-columns: minmax(17rem, 1fr) minmax(0, 1.25fr); gap: 2rem; align-items: center; padding-block: 1.15rem; }
  .wordmark { display: inline-flex; gap: 0.28em; width: fit-content; align-items: baseline; font-size: clamp(1.5rem, 3vw, 2.7rem); font-weight: 900; letter-spacing: -0.07em; line-height: 0.84; text-decoration: none; }
  .wordmark > span { white-space: nowrap; }
  .wordmark mark { padding: 0.04em 0.12em 0.02em; background: var(--accent); color: var(--ink); white-space: nowrap; }
  nav ul { display: flex; gap: 0.2rem 1.3rem; justify-content: flex-end; margin: 0; padding: 0; flex-wrap: wrap; list-style: none; }
  nav a { display: inline-flex; min-height: 2.25rem; align-items: center; font-family: var(--mono); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.04em; text-decoration: none; text-transform: uppercase; }
  nav a:hover { background: var(--accent); }
  nav a[aria-current="page"] { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 0.35rem; text-underline-offset: 0.16rem; }
  @media (max-width: 48rem) { .header-inner { grid-template-columns: minmax(0, 1fr); gap: 1rem; } nav ul { justify-content: flex-start; } }
  @media (max-width: 35rem) {
    .filing-strip { font-size: 0.75rem; }
    .filing-strip span:last-child { display: none; }
    .header-inner { gap: 0.75rem; padding-block: 0.85rem; }
    .wordmark { font-size: clamp(1.4rem, 7.2vw, 1.65rem); }
    nav ul { gap: 0 0.74rem; }
    nav a { min-height: 2.85rem; padding: 0.2rem 0.45rem; font-size: 0.84rem; }
  }
</style>
