---
interface Props { organization: string; received?: string; }
const { organization, received } = Astro.props;
---

<aside class="response-box"><p class="label">Response requested</p><h3>{organization}</h3>{received && <p class="received">Received {received}</p>}<div><slot /></div></aside>

<style>
  .response-box { margin: 2.5rem 0; padding: 1.25rem; border: 1px solid var(--ink); font-family: var(--sans); }
  .label { margin: 0; font-family: var(--mono); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  h3 { margin: 0.5rem 0 0 !important; font-size: 1.4rem !important; }
  .received { margin: 0; color: var(--muted); font-size: 0.8rem; }
  div :global(p) { margin-bottom: 0; }
</style>
