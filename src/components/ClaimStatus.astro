---
interface Props { status: 'confirmed' | 'supported' | 'alleged' | 'unresolved'; }
const { status } = Astro.props;
const labels = { confirmed: 'Confirmed', supported: 'Supported', alleged: 'Alleged', unresolved: 'Unresolved' };
---

<span class:list={['claim-status', status]}><span aria-hidden="true" class="marker"></span>{labels[status]}</span>

<style>
  .claim-status { display: inline-flex; gap: 0.45rem; align-items: center; padding: 0.18rem 0.38rem; border: 1px solid currentColor; font-family: var(--mono); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.05em; line-height: 1.3; text-transform: uppercase; }
  .marker { width: 0.5rem; height: 0.5rem; background: currentColor; }
  .confirmed { color: #17663d; }
  .supported { color: #265c8f; }
  .alleged { color: #79500b; }
  .unresolved { color: var(--accent-dark); }
</style>
