---
interface Props { status: 'confirmed' | 'supported' | 'alleged' | 'unresolved'; }
const { status } = Astro.props;
const labels = { confirmed: 'Confirmed', supported: 'Supported', alleged: 'Alleged', unresolved: 'Unresolved' };
---

<span class:list={['claim-status', status]}><span aria-hidden="true" class="marker"></span><span class="label">{labels[status]}</span></span>

<style>
  .claim-status { display: inline-flex; gap: 0.42rem; align-items: center; padding: 0.22rem 0.42rem 0.18rem; border: 1px solid var(--ink); background: var(--surface); color: var(--ink); font-family: var(--mono); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.06em; line-height: 1.3; text-transform: uppercase; }
  .marker { width: 0.56rem; height: 0.56rem; flex: 0 0 auto; border: 1px solid currentColor; }
  .confirmed .marker { background: var(--ink); }
  .supported .marker { position: relative; }
  .supported .marker::after { position: absolute; inset: 1px 50% 1px 1px; content: ""; background: var(--ink); }
  .alleged .marker { border-radius: 50%; }
  .unresolved .marker { position: relative; border: 0; }
  .unresolved .marker::before, .unresolved .marker::after { position: absolute; top: 50%; left: 0; width: 100%; height: 1px; content: ""; background: var(--ink); transform: rotate(45deg); }
  .unresolved .marker::after { transform: rotate(-45deg); }
  .unresolved { background: var(--color-accent-soft); }
</style>
