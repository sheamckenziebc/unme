---
import type { Investigation } from '../utils/investigations';
interface Props { sources: Investigation['data']['sources']; }
const { sources } = Astro.props;
const dateFormat = new Intl.DateTimeFormat('en-CA', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<section class="source-list" aria-labelledby="source-list-title">
  <div class="heading"><div><p>Document index</p><span>{String(sources.length).padStart(2, '0')} records attached</span></div><h2 id="source-list-title">Sources</h2></div>
  {sources.length > 0 ? <ol>{sources.map((source) => <li><div><span>{source.documentType}</span><strong>{source.title}</strong><p>{source.organization}{source.publishedDate ? ` · ${dateFormat.format(source.publishedDate)}` : ''}</p>{source.note && <p class="note">{source.note}</p>}</div><div class="links"><a class="source-link" href={source.url} rel="external">Original ↗</a>{source.archiveUrl && <a href={source.archiveUrl} rel="external">Archive ↗</a>}</div></li>)}</ol> : <p>No source records are attached to this demonstration.</p>}
</section>

<style>
  .source-list { margin-top: 4.5rem; padding-top: 1.2rem; border-top: 0.45rem solid var(--ink); font-family: var(--sans); }
  .heading { display: flex; align-items: baseline; justify-content: space-between; }
  .heading p { margin: 0; font-family: var(--mono); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  .heading div > span { display: block; margin-top: 0.2rem; color: var(--muted); }
  h2 { margin: 0; font-size: 2.2rem; letter-spacing: -0.04em; }
  ol { margin: 1.5rem 0 0; padding: 0; border-top: 1px solid var(--rule); list-style: none; counter-reset: source; }
  li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1rem; padding: 1.25rem 0.8rem; border-bottom: 1px solid var(--rule); counter-increment: source; }
  li:nth-child(odd) { background: rgb(255 255 255 / 32%); }
  li > div:first-child { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: 0 0.8rem; }
  li > div:first-child::before { grid-row: 1 / 5; content: counter(source, decimal-leading-zero); font-family: var(--mono); font-size: 1.1rem; font-weight: 700; text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 0.38rem; text-underline-offset: -0.15rem; }
  span { color: var(--muted); font-family: var(--mono); font-size: 0.7rem; font-weight: 700; text-transform: uppercase; }
  strong { line-height: 1.3; }
  p { margin: 0.2rem 0 0; color: var(--muted); font-size: 0.84rem; }
  .note { max-width: 42rem; margin-top: 0.5rem; color: var(--ink); }
  .links { display: flex; gap: 0.8rem; align-items: center; font-family: var(--mono); font-size: 0.7rem; font-weight: 700; text-transform: uppercase; }
  .links a { padding-bottom: 0.12rem; border-bottom: 0.35rem solid var(--accent); text-decoration: none; }
  @media (max-width: 38rem) { li { grid-template-columns: 1fr; } .links { padding-left: 3.8rem; } }
</style>
