---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isPublished } from '../../utils/investigations';
import { slugify, withBase } from '../../utils/paths';
const investigations = (await getCollection('investigations')).filter(isPublished);
const topics = [...new Set(investigations.flatMap((item) => item.data.topics))].sort().map((topic) => ({ topic, count: investigations.filter((item) => item.data.topics.includes(topic)).length }));
---

<BaseLayout title="Topics" description="Browse UR NOT MAD ENOUGH investigations by subject."><div class="shell"><header class="page-header"><h1>Topics</h1><p>Browse investigations by subject. The structure can grow without tying the publication to one beat or region.</p></header>{topics.length > 0 ? <ul class="index-list">{topics.map(({ topic, count }) => <li><a href={withBase(`/topics/${slugify(topic)}/`)}><strong>{topic}</strong><span>{count} {count === 1 ? 'investigation' : 'investigations'} →</span></a></li>)}</ul> : <section class="empty-state" aria-labelledby="empty-title"><p class="eyebrow">Index pending</p><h2 id="empty-title">Topics will appear with the first investigation.</h2></section>}</div></BaseLayout>
