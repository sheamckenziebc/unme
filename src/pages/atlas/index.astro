---
import { getCollection } from 'astro:content';
import { readFile } from 'node:fs/promises';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/paths';

type EmployeeDirectoryMeta = {
  checkedDate: string;
  uniqueEmployees: number;
};

const employeeDirectory = JSON.parse(
  await readFile(`${process.cwd()}/public/data/yukon-employees.json`, 'utf8'),
) as EmployeeDirectoryMeta;

const organizations = (await getCollection('organizations')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const people = (await getCollection('people')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const organizationsById = new Map(organizations.map((entry) => [entry.id, entry]));
const leadersFor = (id: string) => people.filter((person) => person.data.responsibilityIds.includes(id));
const departments = organizations.filter((entry) => entry.data.kind === 'Department' || entry.data.kind === 'Directorate');
const corporations = organizations.filter((entry) => entry.data.kind === 'Corporation');
const offices = organizations.filter((entry) => entry.data.kind === 'Office' && entry.data.parentId === 'government-of-yukon');
const assemblyOffice = organizationsById.get('legislative-assembly-office')!;
const elections = organizationsById.get('elections-yukon')!;
const dateFormat = new Intl.DateTimeFormat('en-CA', { dateStyle: 'long', timeZone: 'UTC' });
const checkedDate = new Date(Math.max(...[...organizations, ...people].map((entry) => entry.data.checkedDate.getTime())));
const officialEmployeeDirectory = 'https://find-employee.service.yukon.ca/en/find-employee';
const employeeSource = withBase('/data/yukon-employees.json');
const searchIndexForOrganization = (entry: (typeof organizations)[number]) => [
  entry.data.name,
  entry.data.shortName,
  entry.data.kind,
  entry.data.summary,
  ...entry.data.aliases,
  ...leadersFor(entry.id).flatMap((person) => [person.data.name, person.data.primaryRole]),
].join(' ');
const searchIndexForPerson = (entry: (typeof people)[number]) => [
  entry.data.name,
  entry.data.primaryRole,
  entry.data.district,
  entry.data.party,
  ...entry.data.aliases,
  organizationsById.get(entry.data.organizationId)?.data.name,
  ...entry.data.responsibilityIds.map((id) => organizationsById.get(id)?.data.name),
].filter(Boolean).join(' ');
---

<BaseLayout title="Yukon government directory" description="Search Yukon civil servants, elected officials and government organizations, then open the current official contact record.">
  <div class="directory-page" data-directory data-employee-source={employeeSource}>
    <header class="directory-header shell">
      <p class="eyebrow">Yukon government directory</p>
      <h1>Find the person or office.</h1>
      <p class="lede">Search {employeeDirectory.uniqueEmployees.toLocaleString('en-CA')} civil servants, current elected officials and government organizations by name, job title, department, branch, portfolio or district.</p>

      <form class="directory-search" role="search" action="" method="get">
        <label for="directory-query">Who or what are you looking for?</label>
        <div class="search-row">
          <input id="directory-query" name="q" type="search" placeholder="Try a name, Finance, highways or Mayo-Tatchun" autocomplete="off" spellcheck="false" />
          <button type="submit">Search</button>
        </div>
        <div class="search-tools" hidden>
          <label for="directory-type">Show</label>
          <select id="directory-type">
            <option value="all">Everything</option>
            <option value="employee">Civil servants</option>
            <option value="person">Elected officials</option>
            <option value="organization">Organizations</option>
          </select>
          <button class="clear-search" type="button">Clear search</button>
        </div>
      </form>

      <div class="coverage" aria-label="Directory coverage">
        <span><strong>{employeeDirectory.uniqueEmployees.toLocaleString('en-CA')}</strong> civil servants</span>
        <span><strong>{people.length}</strong> current MLAs</span>
        <span><strong>{organizations.length - 3}</strong> government organizations</span>
      </div>
    </header>

    <main class="directory-main shell">
      <section class="search-results" aria-labelledby="results-title" hidden>
        <div class="section-heading compact">
          <div><p class="eyebrow">Search results</p><h2 id="results-title">Matches</h2></div>
          <p class="result-count" role="status" aria-live="polite"></p>
        </div>

        <p class="loading-state" role="status" hidden>Searching the civil-service roster…</p>
        <ul class="result-list employee-result-list" data-employee-results></ul>
        <ul class="result-list local-result-list">
          {people.map((person) => {
            const responsibilities = person.data.responsibilityIds.map((id) => organizationsById.get(id)!);
            return <li data-result data-result-type="person" data-search={searchIndexForPerson(person)}>
              <article class="result-card">
                <p class="result-kind">{person.data.kind}</p>
                <h3>{person.data.name}</h3>
                <p class="result-role">{person.data.primaryRole}</p>
                <p class="result-meta">{person.data.district} · {person.data.party}</p>
                {responsibilities.length > 0 && <p class="portfolios"><span>Responsible for</span>{responsibilities.map((entry) => entry.data.shortName).join(' · ')}</p>}
                <a href={person.data.officialUrl}>Official Assembly profile <span aria-hidden="true">↗</span></a>
              </article>
            </li>;
          })}
          {organizations.filter((entry) => !['government-of-yukon', 'yukon-legislative-assembly'].includes(entry.id)).map((entry) => {
            const leaders = leadersFor(entry.id);
            return <li data-result data-result-type="organization" data-search={searchIndexForOrganization(entry)}>
              <article class="result-card">
                <p class="result-kind">{entry.data.kind}</p>
                <h3>{entry.data.name}</h3>
                <p class="result-role">{entry.data.summary}</p>
                {leaders.length > 0 && <p class="result-meta">Minister: {leaders.map((person) => person.data.name).join(', ')}</p>}
                <div class="result-links">
                  {entry.data.staffDirectoryUrl && <a href={entry.data.staffDirectoryUrl}>Browse staff <span aria-hidden="true">↗</span></a>}
                  <a href={entry.data.officialUrl}>Official page <span aria-hidden="true">↗</span></a>
                </div>
              </article>
            </li>;
          })}
        </ul>

        <button class="show-more-results" type="button" hidden>Show 50 more</button>

        <div class="no-local-results" hidden>
          <h3>No snapshot match.</h3>
          <p>Try fewer words, check the spelling or search the live official directory below.</p>
        </div>

        <aside class="official-search-card">
          <div><p class="eyebrow">Official source</p><h3>Verify the current contact record.</h3><p>Your search term carries over to the Government of Yukon service, where current work email addresses and phone numbers are maintained.</p></div>
          <a data-official-search href={officialEmployeeDirectory}>Open the official directory <span aria-hidden="true">↗</span></a>
        </aside>
      </section>

      <div class="directory-browser">
        <nav class="jump-links" aria-label="Directory sections">
          <a href="#executive-government">Executive government</a>
          <a href="#elected-assembly">Elected Assembly</a>
          <a href="#independent-office">Independent office</a>
        </nav>

        <section id="executive-government" class="directory-section" aria-labelledby="executive-title">
          <div class="section-heading">
            <div><p class="eyebrow">Organization chart / Executive</p><h2 id="executive-title">Government of Yukon</h2></div>
            <p>Open an organization to see its responsible minister and current staff-directory route.</p>
          </div>

          <div class="root-node"><span>Executive government</span><strong>Government of Yukon</strong></div>
          <div class="tree-stem" aria-hidden="true"></div>

          <section class="organization-group" aria-labelledby="departments-title">
            <h3 id="departments-title">Departments and directorates</h3>
            <div class="organization-grid">
              {departments.map((entry) => {
                const leaders = leadersFor(entry.id);
                return <details class="organization-node" id={`org-${entry.id}`}>
                  <summary><span>{entry.data.kind}</span><strong>{entry.data.name}</strong><i aria-hidden="true"></i></summary>
                  <div class="organization-details">
                    <p>{entry.data.summary}</p>
                    {leaders.length > 0 && <p class="organization-leader"><span>Responsible minister</span>{leaders.map((person) => <a href={person.data.officialUrl}>{person.data.name}</a>)}</p>}
                    <div class="organization-links">{entry.data.staffDirectoryUrl && <a href={entry.data.staffDirectoryUrl}>Browse staff <span aria-hidden="true">↗</span></a>}<a href={entry.data.officialUrl}>Official page <span aria-hidden="true">↗</span></a></div>
                  </div>
                </details>;
              })}
            </div>
          </section>

          <section class="organization-group" aria-labelledby="corporations-title">
            <h3 id="corporations-title">Crown corporations and commissions</h3>
            <div class="organization-grid">
              {corporations.map((entry) => {
                const leaders = leadersFor(entry.id);
                return <details class="organization-node" id={`org-${entry.id}`}>
                  <summary><span>{entry.data.kind}</span><strong>{entry.data.name}</strong><i aria-hidden="true"></i></summary>
                  <div class="organization-details">
                    <p>{entry.data.summary}</p>
                    {leaders.length > 0 && <p class="organization-leader"><span>Responsible minister</span>{leaders.map((person) => <a href={person.data.officialUrl}>{person.data.name}</a>)}</p>}
                    <div class="organization-links">{entry.data.staffDirectoryUrl && <a href={entry.data.staffDirectoryUrl}>Browse staff <span aria-hidden="true">↗</span></a>}<a href={entry.data.officialUrl}>Official page <span aria-hidden="true">↗</span></a></div>
                  </div>
                </details>;
              })}
            </div>
          </section>

          {offices.length > 0 && <section class="organization-group" aria-labelledby="offices-title">
            <h3 id="offices-title">Political office</h3>
            <div class="organization-grid">{offices.map((entry) => <details class="organization-node" id={`org-${entry.id}`}><summary><span>{entry.data.kind}</span><strong>{entry.data.name}</strong><i aria-hidden="true"></i></summary><div class="organization-details"><p>{entry.data.summary}</p><div class="organization-links">{entry.data.staffDirectoryUrl && <a href={entry.data.staffDirectoryUrl}>Browse staff <span aria-hidden="true">↗</span></a>}<a href={entry.data.officialUrl}>Official page <span aria-hidden="true">↗</span></a></div></div></details>)}</div>
          </section>}
        </section>

        <section id="elected-assembly" class="directory-section assembly-section" aria-labelledby="assembly-title">
          <div class="section-heading">
            <div><p class="eyebrow">Organization chart / Legislature</p><h2 id="assembly-title">Yukon Legislative Assembly</h2></div>
            <p>MLAs are elected officeholders, not civil servants. Cabinet ministers lead executive portfolios; other MLAs scrutinize government and represent their districts.</p>
          </div>

          <ul class="people-grid">
            {people.map((person) => <li><a href={person.data.officialUrl}><span>{person.data.primaryRole}</span><strong>{person.data.name}</strong><small>{person.data.district} · {person.data.party}</small></a></li>)}
          </ul>

          <details class="organization-node single-node" id={`org-${assemblyOffice.id}`}>
            <summary><span>{assemblyOffice.data.kind}</span><strong>{assemblyOffice.data.name}</strong><i aria-hidden="true"></i></summary>
            <div class="organization-details"><p>{assemblyOffice.data.summary}</p><div class="organization-links"><a href={assemblyOffice.data.staffDirectoryUrl}>Browse staff <span aria-hidden="true">↗</span></a><a href={assemblyOffice.data.officialUrl}>Official page <span aria-hidden="true">↗</span></a></div></div>
          </details>
        </section>

        <section id="independent-office" class="directory-section independent-section" aria-labelledby="independent-title">
          <div class="section-heading"><div><p class="eyebrow">Independent administration</p><h2 id="independent-title">Elections Yukon</h2></div><p>This office is presented separately so the chart does not imply executive control.</p></div>
          <details class="organization-node single-node" id={`org-${elections.id}`}><summary><span>{elections.data.kind}</span><strong>{elections.data.name}</strong><i aria-hidden="true"></i></summary><div class="organization-details"><p>{elections.data.summary}</p><div class="organization-links"><a href={elections.data.staffDirectoryUrl}>Browse staff <span aria-hidden="true">↗</span></a><a href={elections.data.officialUrl}>Official page <span aria-hidden="true">↗</span></a></div></div></details>
        </section>
      </div>

      <footer class="directory-note">
        <p><strong>Coverage is explicit.</strong> The searchable snapshot contains {employeeDirectory.uniqueEmployees.toLocaleString('en-CA')} unique civil servants from all {organizations.length - 3} listed government organizations, checked {dateFormat.format(new Date(`${employeeDirectory.checkedDate}T00:00:00Z`))}. It stores names and job context, not phone numbers or email addresses; each result links to the current official contact record. The elected roster covers all {people.length} current members of the 36th Legislative Assembly and Cabinet portfolio assignments, checked {dateFormat.format(checkedDate)}.</p>
      </footer>
    </main>
  </div>
</BaseLayout>

<script>
  type Employee = {
    name: string;
    title: string;
    department: string;
    division: string;
    branch: string;
    unit: string;
    community: string;
    organizationId: string;
    officialUrl: string;
  };

  type EmployeeDirectory = {
    uniqueEmployees: number;
    employees: Employee[];
  };

  const root = document.querySelector<HTMLElement>('[data-directory]');
  if (root) {
    const form = root.querySelector<HTMLFormElement>('.directory-search')!;
    const input = root.querySelector<HTMLInputElement>('#directory-query')!;
    const type = root.querySelector<HTMLSelectElement>('#directory-type')!;
    const tools = root.querySelector<HTMLElement>('.search-tools')!;
    const clear = root.querySelector<HTMLButtonElement>('.clear-search')!;
    const browser = root.querySelector<HTMLElement>('.directory-browser')!;
    const results = root.querySelector<HTMLElement>('.search-results')!;
    const count = root.querySelector<HTMLElement>('.result-count')!;
    const empty = root.querySelector<HTMLElement>('.no-local-results')!;
    const loading = root.querySelector<HTMLElement>('.loading-state')!;
    const employeeResults = root.querySelector<HTMLUListElement>('[data-employee-results]')!;
    const showMore = root.querySelector<HTMLButtonElement>('.show-more-results')!;
    const officialLink = root.querySelector<HTMLAnchorElement>('[data-official-search]')!;
    const items = [...root.querySelectorAll<HTMLElement>('[data-result]')];
    const officialRoot = 'https://find-employee.service.yukon.ca/en/find-employee';
    const employeeSource = root.dataset.employeeSource!;
    const normalize = (value: string) => value.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();
    const pageSize = 50;
    let visibleEmployeeLimit = pageSize;
    let employeeDirectoryPromise: Promise<EmployeeDirectory> | undefined;
    let employeeMatches: Employee[] = [];
    let updateNumber = 0;

    const loadEmployees = () => {
      employeeDirectoryPromise ??= fetch(employeeSource).then(async (response) => {
        if (!response.ok) throw new Error(`Employee directory request failed: ${response.status}`);
        return response.json() as Promise<EmployeeDirectory>;
      });
      return employeeDirectoryPromise;
    };

    const employeeIndex = (employee: Employee) => normalize([
      employee.name,
      employee.title,
      employee.department,
      employee.division,
      employee.branch,
      employee.unit,
      employee.community,
    ].join(' '));

    const employeeScore = (employee: Employee, query: string) => {
      const name = normalize(employee.name);
      const title = normalize(employee.title);
      if (name === query) return 0;
      if (name.startsWith(query)) return 1;
      if (title === query) return 2;
      if (title.startsWith(query)) return 3;
      if (name.includes(query)) return 4;
      if (title.includes(query)) return 5;
      return 6;
    };

    const appendText = (parent: HTMLElement, tag: keyof HTMLElementTagNameMap, className: string, value: string) => {
      const element = document.createElement(tag);
      element.className = className;
      element.textContent = value;
      parent.append(element);
      return element;
    };

    const renderEmployees = () => {
      employeeResults.replaceChildren();
      for (const employee of employeeMatches.slice(0, visibleEmployeeLimit)) {
        const item = document.createElement('li');
        const article = document.createElement('article');
        article.className = 'result-card';
        appendText(article, 'p', 'result-kind', 'Civil servant');
        appendText(article, 'h3', '', employee.name);
        appendText(article, 'p', 'result-role', employee.title);

        const context = [employee.department, employee.branch || employee.division, employee.community]
          .filter(Boolean)
          .filter((value, index, values) => values.indexOf(value) === index)
          .join(' · ');
        appendText(article, 'p', 'result-meta', context);

        const link = document.createElement('a');
        link.href = employee.officialUrl;
        link.textContent = 'Open current official contact record ↗';
        article.append(link);
        item.append(article);
        employeeResults.append(item);
      }
      showMore.hidden = employeeMatches.length <= visibleEmployeeLimit;
    };

    const setCount = (employeeCount: number, localCount: number) => {
      const parts = [];
      if (employeeCount) parts.push(`${employeeCount.toLocaleString('en-CA')} civil ${employeeCount === 1 ? 'servant' : 'servants'}`);
      if (localCount) parts.push(`${localCount} ${localCount === 1 ? 'other match' : 'other matches'}`);
      count.textContent = parts.length ? parts.join(' · ') : 'No matches';
    };

    const update = async (push = false, resetLimit = true) => {
      const thisUpdate = ++updateNumber;
      const query = input.value.trim();
      const normalizedQuery = normalize(query);
      const words = normalizedQuery.split(/\s+/).filter(Boolean);
      const filter = type.value;
      let localMatches = 0;

      if (resetLimit) visibleEmployeeLimit = pageSize;

      items.forEach((item) => {
        const index = normalize(item.dataset.search ?? '');
        const visible = words.length > 0 && (filter === 'all' || item.dataset.resultType === filter) && words.every((word) => index.includes(word));
        item.hidden = !visible;
        if (visible) localMatches += 1;
      });

      const searching = words.length > 0;
      const searchEmployees = searching && (filter === 'all' || filter === 'employee');
      root.classList.toggle('is-searching', searching);
      browser.hidden = searching;
      results.hidden = !searching;
      tools.hidden = !searching;
      empty.hidden = true;
      loading.hidden = !searchEmployees;
      employeeResults.replaceChildren();
      showMore.hidden = true;
      employeeMatches = [];
      count.textContent = searching ? (searchEmployees ? 'Searching civil servants…' : `${localMatches} ${localMatches === 1 ? 'match' : 'matches'}`) : '';
      const encoded = encodeURIComponent(query).replaceAll('%20', '.');
      officialLink.href = searching ? `${officialRoot}/search/keyword=${encoded}&department=any-department` : officialRoot;
      officialLink.firstChild!.textContent = searching ? `Verify “${query}” in the official directory ` : 'Open the official directory ';

      if (push) {
        const url = new URL(window.location.href);
        if (query) url.searchParams.set('q', query); else url.searchParams.delete('q');
        if (filter !== 'all') url.searchParams.set('type', filter); else url.searchParams.delete('type');
        history.replaceState(null, '', url);
      }

      if (!searchEmployees) {
        loading.hidden = true;
        empty.hidden = !searching || localMatches > 0;
        return;
      }

      try {
        const directory = await loadEmployees();
        if (thisUpdate !== updateNumber) return;
        employeeMatches = directory.employees
          .filter((employee) => words.every((word) => employeeIndex(employee).includes(word)))
          .sort((a, b) => employeeScore(a, normalizedQuery) - employeeScore(b, normalizedQuery) || a.name.localeCompare(b.name) || a.title.localeCompare(b.title));
        renderEmployees();
        loading.hidden = true;
        empty.hidden = employeeMatches.length + localMatches > 0;
        setCount(employeeMatches.length, localMatches);
      } catch (error) {
        if (thisUpdate !== updateNumber) return;
        console.error(error);
        loading.hidden = true;
        empty.hidden = localMatches > 0;
        count.textContent = localMatches ? `${localMatches} ${localMatches === 1 ? 'match' : 'matches'} · staff search unavailable` : 'Staff search unavailable';
      }
    };

    const params = new URLSearchParams(window.location.search);
    input.value = params.get('q') ?? '';
    const requestedType = params.get('type');
    if (requestedType && [...type.options].some((option) => option.value === requestedType)) type.value = requestedType;
    form.addEventListener('submit', (event) => { event.preventDefault(); void update(true); });
    input.addEventListener('input', () => { void update(true); });
    type.addEventListener('change', () => { void update(true); });
    clear.addEventListener('click', () => { input.value = ''; type.value = 'all'; void update(true); input.focus(); });
    showMore.addEventListener('click', () => { visibleEmployeeLimit += pageSize; renderEmployees(); });
    window.addEventListener('keydown', (event) => {
      if (event.key === '/' && document.activeElement !== input) { event.preventDefault(); input.focus(); }
      if (event.key === 'Escape' && document.activeElement === input && input.value) { input.value = ''; void update(true); }
    });
    void update(false);
  }
</script>

<style>
  .directory-page { background: #f5f4ed; color: #171b17; }
  .directory-header { padding-block: clamp(2.25rem, 4vw, 3.5rem) 1.75rem; }
  .eyebrow { margin: 0 0 0.65rem; color: #667064; font-family: var(--mono); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; }
  h1 { max-width: 12ch; margin: 0; font-size: clamp(2.7rem, 5.5vw, 5rem); letter-spacing: -0.075em; line-height: 0.86; text-wrap: balance; }
  .lede { max-width: 46rem; margin: 1rem 0 1.4rem; color: #4e584d; font-family: var(--serif); font-size: clamp(1.05rem, 2vw, 1.35rem); }
  .directory-search { max-width: 62rem; padding: 0.85rem; border: 1px solid #9aa294; border-radius: 0.7rem; background: #fff; box-shadow: 0 12px 35px #2631240d; }
  .directory-search > label { display: block; margin: 0 0 0.55rem 0.15rem; font-size: 0.82rem; font-weight: 700; }
  .search-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.55rem; }
  .search-row input { min-width: 0; min-height: 3.5rem; padding: 0.75rem 1rem; border: 2px solid #384337; border-radius: 0.4rem; background: #fff; color: #171b17; font: inherit; font-size: 1rem; }
  .search-row input::placeholder { color: #777e75; opacity: 1; }
  .search-row button { min-height: 3.5rem; padding: 0.75rem 1.25rem; border: 0; border-radius: 0.4rem; background: #162018; color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
  .search-row button:hover { background: #344335; }
  .search-tools { display: flex; gap: 0.5rem 0.75rem; align-items: center; margin-top: 0.75rem; flex-wrap: wrap; }
  .search-tools label { font-size: 0.78rem; color: #5d655b; }
  .search-tools select, .clear-search { min-height: 44px; padding: 0.5rem 0.75rem; border: 1px solid #9da499; border-radius: 0.35rem; background: #fff; color: #171b17; font: inherit; font-size: 0.82rem; }
  .clear-search { margin-left: auto; cursor: pointer; text-decoration: underline; text-underline-offset: 0.2rem; }
  .coverage { display: flex; gap: 0.65rem 1.5rem; max-width: 62rem; padding-top: 1rem; flex-wrap: wrap; color: #60685f; font-size: 0.78rem; }
  .coverage span { display: inline-flex; gap: 0.35rem; }
  .coverage strong { color: #202620; }
  .directory-main { padding-bottom: 5rem; }
  .directory-page.is-searching .directory-header { padding-block: 1.5rem 0.75rem; }
  .directory-page.is-searching .directory-header h1 { font-size: clamp(2.25rem, 4vw, 3.5rem); line-height: 0.9; }
  .directory-page.is-searching .directory-header .lede, .directory-page.is-searching .coverage { display: none; }
  .jump-links { display: flex; gap: 0.35rem 1.25rem; padding-block: 1.1rem; border-block: 1px solid #c7cbc3; flex-wrap: wrap; }
  .jump-links a { display: inline-flex; min-height: 44px; align-items: center; color: #354037; font-size: 0.82rem; font-weight: 700; }
  .directory-section { padding-block: clamp(2.5rem, 6vw, 4.5rem); border-bottom: 1px solid #c7cbc3; scroll-margin-top: 1rem; }
  .section-heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.62fr); gap: 1.5rem 3rem; align-items: end; margin-bottom: 2rem; }
  .section-heading.compact { grid-template-columns: 1fr auto; }
  .section-heading h2 { margin: 0; font-size: clamp(2rem, 4vw, 3.5rem); letter-spacing: -0.055em; line-height: 0.95; }
