---
import { getCollection } from 'astro:content';
import InvestigationCard from '../../components/InvestigationCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isPublished, newestFirst } from '../../utils/investigations';
const investigations = newestFirst((await getCollection('investigations')).filter(isPublished));
---

<BaseLayout title="Archive" description="Every public UR NOT MAD ENOUGH Dossier and Brief, newest first."><div class="shell"><header class="page-header"><h1>Archive</h1><p>Every public Dossier and Brief, held to the same evidentiary standard and ordered newest first.</p></header>{investigations.length > 0 ? <div class="listing-grid listing">{investigations.map((investigation) => <InvestigationCard investigation={investigation} />)}</div> : <section class="empty-state" aria-labelledby="empty-title"><p class="eyebrow">Public archive / 00 files</p><h2 id="empty-title">The first story is still being reported.</h2><p>It will appear here after the evidence, response, fairness and publication-readiness gates are complete.</p></section>}</div></BaseLayout>
<style>.listing { margin: 2rem 0 6rem; }</style>
