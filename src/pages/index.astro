---
import { getCollection } from 'astro:content';
import InvestigationCard from '../components/InvestigationCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { isPublished, newestFirst } from '../utils/investigations';
import { slugify, withBase } from '../utils/paths';

const investigations = newestFirst((await getCollection('investigations')).filter(isPublished));
const featured = investigations.find((item) => item.data.featured) ?? investigations[0];
const recent = investigations.filter((item) => item.id !== featured?.id).slice(0, 3);
const topics = [...new Set(investigations.flatMap((item) => item.data.topics))];
const jurisdictions = [...new Set(investigations.map((item) => item.data.jurisdiction))];
---

<BaseLayout>
  <section class="hero shell">
    <div class="manifesto">
      <p class="kicker">Independent accountability reporting</p>
      <h1><span>UR NOT</span><span>MAD ENOUGH</span></h1>
      <p>Evidence worth paying attention to.</p>
    </div>
    <div class="principle"><strong>We do not manufacture outrage.</strong><p>We show people the evidence and let the facts earn the reaction.</p></div>
  </section>
  {featured && <section class="featured shell" aria-labelledby="featured-title"><div class="section-heading"><h2 id="featured-title">Featured investigation</h2><span>01</span></div><InvestigationCard investigation={featured} prominent /></section>}
  <section class="recent shell" aria-labelledby="recent-title"><div class="section-heading"><h2 id="recent-title">Recent investigations</h2><a href={withBase('/investigations/')}>View all →</a></div><div class="listing-grid">{recent.map((investigation) => <InvestigationCard investigation={investigation} />)}</div></section>
  <section class="method shell" aria-labelledby="method-title"><div><p class="kicker">How we report</p><h2 id="method-title">Aggressive curiosity.<br />Restrained conclusions.<br />Primary evidence.</h2></div><div><p>Public records can be technically available while remaining practically invisible. We find them, connect them and explain what they establish—and what they do not.</p><a href={withBase('/methodology/')}>Read our methodology →</a></div></section>
  <section class="browse shell" aria-label="Browse reporting">
    <div><div class="section-heading"><h2>Topics</h2><a href={withBase('/topics/')}>All topics →</a></div><ul>{topics.slice(0, 4).map((topic) => <li><a href={withBase(`/topics/${slugify(topic)}/`)}>{topic}</a></li>)}</ul></div>
    <div><div class="section-heading"><h2>Jurisdictions</h2><a href={withBase('/jurisdictions/')}>All jurisdictions →</a></div><ul>{jurisdictions.slice(0, 4).map((jurisdiction) => <li><a href={withBase(`/jurisdictions/${slugify(jurisdiction)}/`)}>{jurisdiction}</a></li>)}</ul></div>
  </section>
</BaseLayout>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(16rem, 0.35fr); min-height: 42rem; padding-block: 4rem 3rem; border-bottom: 0.4rem solid var(--ink); }
  .manifesto { display: flex; flex-direction: column; justify-content: space-between; }
  h1 { display: flex; margin: 1.5rem 0; flex-direction: column; font-size: clamp(4.2rem, 12.5vw, 11.5rem); font-weight: 900; letter-spacing: -0.09em; line-height: 0.7; text-transform: uppercase; }
  h1 span:last-child { color: var(--accent); }
  .manifesto > p:last-child { margin: 0; font-family: var(--serif); font-size: clamp(1.4rem, 3vw, 2.25rem); }
  .principle { align-self: end; padding: 1.2rem 0 0 1.2rem; border-top: 0.15rem solid var(--ink); border-left: 0.15rem solid var(--ink); }
  .principle strong { font-size: 1.15rem; }
  .principle p { margin: 0.5rem 0 0; color: var(--muted); font-family: var(--serif); }
  .featured, .recent { padding-block: 4rem; }
  .featured { border-bottom: 1px solid var(--rule); }
  .method { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 4rem; padding-block: 5rem; border-block: 0.2rem solid var(--ink); }
  .method h2 { margin: 0; font-size: clamp(2.1rem, 5vw, 4.2rem); letter-spacing: -0.055em; line-height: 0.95; }
  .method > div:last-child { max-width: 32rem; align-self: end; font-family: var(--serif); font-size: 1.2rem; }
  .method a { font-family: var(--mono); font-size: 0.78rem; font-weight: 700; }
  .browse { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; padding-block: 4rem 6rem; }
  .browse ul { margin: 0; padding: 0; border-top: 1px solid var(--rule); list-style: none; }
  .browse li { border-bottom: 1px solid var(--rule); }
  .browse li a { display: block; padding: 0.8rem 0; font-size: 1.1rem; font-weight: 700; text-decoration: none; }
  @media (max-width: 52rem) { .hero { grid-template-columns: 1fr; min-height: 36rem; } .principle { max-width: 24rem; } .method, .browse { grid-template-columns: 1fr; gap: 2rem; } }
  @media (max-width: 35rem) { .hero { min-height: 31rem; padding-top: 2.5rem; } h1 { font-size: clamp(3.4rem, 21vw, 6.4rem); } }
</style>
