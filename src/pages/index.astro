---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';

const organizations = await getCollection('organizations');
const people = await getCollection('people');
---

<BaseLayout description="Find Yukon elected officials, government departments and current public-service staff from one clear directory.">
  <div class="directory-home">
    <main class="home-main shell">
      <p class="eyebrow">Yukon government directory</p>
      <h1>Find who<br />does what.</h1>
      <p class="intro">One search for elected officials, portfolios and public-service organizations—then a direct route to the current official staff record.</p>

      <form class="home-search" role="search" action={withBase('/atlas/')} method="get">
        <label for="home-query">Search the directory</label>
        <div><input id="home-query" name="q" type="search" placeholder="Name, title, department, branch or district" autocomplete="off" /><button type="submit">Find</button></div>
      </form>

      <div class="home-actions">
        <a class="primary-action" href={withBase('/atlas/')}>Browse the organization chart <span aria-hidden="true">→</span></a>
        <a href="https://find-employee.service.yukon.ca/en/find-employee">Go straight to official staff records <span aria-hidden="true">↗</span></a>
      </div>

      <dl class="coverage">
        <div><dt>{people.length}</dt><dd>current elected officials</dd></div>
        <div><dt>{organizations.length - 3}</dt><dd>government organizations</dd></div>
        <div><dt>1 click</dt><dd>to live civil-service records</dd></div>
      </dl>

      <aside class="scope-note">
        <strong>Built to answer one question quickly:</strong>
        <p>Who is responsible, where do they sit, and where is their current official contact record?</p>
      </aside>
    </main>
  </div>
</BaseLayout>

<style>
  .directory-home { min-height: min(50rem, calc(100vh - 8rem)); background: #f5f4ed; color: #171b17; }
  .home-main { display: flex; min-height: min(46rem, calc(100vh - 8rem)); padding-block: clamp(3rem, 9vw, 7rem) 3rem; flex-direction: column; justify-content: center; }
  .eyebrow { margin: 0 0 0.75rem; color: #657064; font-family: var(--mono); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; }
  h1 { max-width: 10ch; margin: 0; font-size: clamp(3.4rem, 10vw, 8.5rem); letter-spacing: -0.085em; line-height: 0.78; }
  .intro { max-width: 48rem; margin: 1.6rem 0 2rem; color: #4c564d; font-family: var(--serif); font-size: clamp(1.08rem, 2vw, 1.42rem); line-height: 1.5; }
  .home-search { max-width: 62rem; padding: 0.85rem; border: 1px solid #969f93; border-radius: 0.7rem; background: #fff; box-shadow: 0 12px 35px #2631240d; }
  .home-search label { display: block; margin: 0 0 0.55rem 0.15rem; font-size: 0.82rem; font-weight: 700; }
  .home-search > div { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.55rem; }
  .home-search input { min-width: 0; min-height: 3.6rem; padding: 0.8rem 1rem; border: 2px solid #384337; border-radius: 0.4rem; color: #171b17; font: inherit; font-size: 1rem; }
  .home-search input::placeholder { color: #747c73; opacity: 1; }
  .home-search button { min-height: 3.6rem; padding-inline: 1.5rem; border: 0; border-radius: 0.4rem; background: #162018; color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
  .home-search button:hover { background: #344335; }
  .home-actions { display: flex; gap: 0.5rem 1.25rem; align-items: center; margin-top: 1rem; flex-wrap: wrap; }
  .home-actions a { display: inline-flex; min-height: 44px; align-items: center; color: #374139; font-size: 0.8rem; font-weight: 700; }
  .home-actions .primary-action { gap: 1.5rem; padding: 0.6rem 0.8rem; border: 1px solid #9da599; border-radius: 0.35rem; text-decoration: none; }
  .home-actions .primary-action:hover { background: #fff; }
  .coverage { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); max-width: 62rem; margin: 2.5rem 0 0; padding: 1rem 0 0; border-top: 1px solid #c2c7be; }
  .coverage div { padding-right: 1rem; }
  .coverage dt { font-size: 1.3rem; font-weight: 800; letter-spacing: -0.035em; }
  .coverage dd { margin: 0.2rem 0 0; color: #646c63; font-size: 0.75rem; }
  .scope-note { display: flex; gap: 0.4rem 1rem; max-width: 62rem; margin-top: 2rem; padding-top: 1rem; border-top: 1px solid #c2c7be; flex-wrap: wrap; color: #5e675e; font-size: 0.78rem; }
  .scope-note strong { color: #252c26; }
  .scope-note p { margin: 0; }
  input:focus-visible, button:focus-visible, a:focus-visible { outline: 3px solid #cb9800; outline-offset: 3px; }
  @media (max-width: 35rem) {
    .home-main { justify-content: flex-start; padding-top: 3rem; }
    h1 { font-size: clamp(3.1rem, 17vw, 4.8rem); }
    .intro { font-size: 1rem; }
    .home-search > div { grid-template-columns: 1fr; }
    .home-search button { width: 100%; }
    .coverage { grid-template-columns: 1fr; gap: 0.75rem; }
  }
</style>
