---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isPublished } from '../../utils/investigations';
import { slugify, withBase } from '../../utils/paths';
const investigations = (await getCollection('investigations')).filter(isPublished);
const jurisdictions = [...new Set(investigations.map((item) => item.data.jurisdiction))].sort().map((jurisdiction) => ({ jurisdiction, count: investigations.filter((item) => item.data.jurisdiction === jurisdiction).length }));
---

<BaseLayout title="Jurisdictions" description="Browse UR NOT MAD ENOUGH reporting by place or public authority."><div class="shell"><header class="page-header"><h1>Jurisdictions</h1><p>Accountability has no preferred geography. Browse Dossiers and Briefs by the place or authority involved.</p></header>{jurisdictions.length > 0 ? <ul class="index-list">{jurisdictions.map(({ jurisdiction, count }) => <li><a href={withBase(`/jurisdictions/${slugify(jurisdiction)}/`)}><strong>{jurisdiction}</strong><span>{count} {count === 1 ? 'publication' : 'publications'} →</span></a></li>)}</ul> : <section class="empty-state" aria-labelledby="empty-title"><p class="eyebrow">Index pending</p><h2 id="empty-title">Jurisdictions will appear with the first publication.</h2></section>}</div></BaseLayout>
